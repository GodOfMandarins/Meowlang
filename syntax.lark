//Startuoja programa
start: statement*

//funkcijos
?statement: assign_stmt
    | print_stmt
    | for_stmt
    | if_stmt
    | function_def
    | return_stmt
    | expr
    | nine_lives_stmt
    | while_stmt
    | break_stmt
    | continue_stmt
    | pick_toy_stmt
    | landonfeet_stmt

assign_stmt: CNAME "=" expr

//print statement
print_stmt: PRINT_KW expr
PRINT_KW.10: "Print" | "scream"

//9 lives 
nine_lives_stmt: "ninelives" "(" LIVES ")" block "allliveslost" "(" CNAME ")" block
LIVES: /[1-9]/

//for loop
for_stmt: "zoomies" CNAME "in" expr "{" statement* "}"

//if
if_stmt: "ifpet" expr block ("elsebite" expr block)* ["bite" block] //expr = condition. Cia nera expr nes else neturi condition
block: "{" statement* "}"

//functions
function_def: "cattrick" CNAME "(" [parameters] ")" block
parameters: CNAME ("," CNAME)*
return_stmt: "cough" expr

//while 
while_stmt: "chase_tail" expr block
break_stmt: "nap"
continue_stmt: "keepzooming"

//toy 
pick_toy_stmt: "pickToy" expr "{" toy_case+ ["bite" block] "}"
toy_case: "toy" expr block

//landonfeet 
landonfeet_stmt: "landonfeet" expr "as" CNAME block "fall" "(" CNAME ")" block

//if gramatika
?expr: or_expr

?or_expr: and_expr
        | or_expr "||" and_expr -> logical_or

?and_expr: not_expr
        | and_expr "&&" not_expr -> logical_and

?not_expr: "!" not_expr -> logical_not
        | comparison

?comparison: sum
    | sum "==" sum -> equal
    | sum "!=" sum -> not_equal
    | sum "<" sum -> less
    | sum ">" sum -> greater
    | sum ">=" sum -> greater_equal
    | sum "<=" sum -> less_equal

?sum: term
    | sum "+" term -> add
    | sum "-" term -> sub

//matematika
?term: factor
    | term "*" factor -> mul
    | term "/" factor -> div

//variable
?factor: NUMBER -> number
    | SCHRODINGER -> null
    | "[" [args] "]" -> list_literal
    | CNAME "." CNAME "(" [args] ")" -> method_call
    | CNAME "(" [args] ")" -> call
    | CNAME -> var
    | ESCAPED_STRING -> string
    | bool_val -> boolean
    | "(" expr ")"
    | "ok" "(" expr ")" -> ok_result
    | "err" "(" expr ")" -> err_result

args: expr ("," expr)*

//bool
bool_val: "purr" -> true
        | "hiss" -> false

SCHRODINGER.10: "schrodinger"

//terminals & whitespace
%import common.CNAME
%import common.NUMBER
%import common.ESCAPED_STRING
%import common.WS //whitespace (spaces, tabs, \n etc)
//# - komentaro pradzia
//^ any character besides \n
//* - any amount of characters
COMMENT: /#[^\n]*/
//ignore: kad ignoruotu juos in the final string passed for parsing
%ignore WS
%ignore COMMENT