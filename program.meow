#if, ifelse, else
scream "IF, IFELSE AND ELSE"
y = 6
ifpet y == 13 {
    scream "suveike if:"
    scream "im good guys, i swear"
}elsebite y/3 == 2 {
    scream "suveike ifelse:"
    scream "cia ifelse"
}bite              {
    scream "suveike else:"
    scream "atsibodo. iseinu"
}
scream "------------"

