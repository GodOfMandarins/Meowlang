#function, return
scream "Cia add funkcija:"
cattrick add(a, b) {
    cough a + b
}
sum = add(2, 3)
scream sum
scream ""

scream "Cia div funkcija:"
cattrick div(c,d){
    cough c/d
}
divide = div(7,3)
scream divide

cattrick mult(e,f,g){
    one = e+f
    two = f+g
    three = g+e
    ifpet three > one{
        cough e
    }elsebite three < two{
        cough f
    }bite{
        cough g
    }
}
multiple = mult(1,2,3)
scream multiple
scream "------------"

